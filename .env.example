# Settings for the website. Copy to .env.local to try them on your computer; on Vercel, set them in
# Project Settings → Environment Variables and redeploy. No secrets here.

# The public address once a custom domain is set (canonical links, sitemap, social previews).
# Without it the site uses Vercel's production address.
# SITE_URL=https://www.example.com

# "true" lets search engines index the production site. Leave it unset until launch: the site still shows
# [PRICE] placeholders and the example email address. Preview deployments are never indexed.
# ALLOW_INDEXING=true
